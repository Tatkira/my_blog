<header id="header" <% if (is_home()) { %>class="full-page"<% } else if (is_post()) { %>class="post-header"<% } %>>
  <div id="banner"></div>
  <script>
    // Bing Random Background
    (function() {
      var bingUrl = 'https://bing.biturl.top/?resolution=1920&format=image&index=random&mkt=zh-CN';
      var img = new Image();
      img.src = bingUrl;
      
      img.onload = function() {
        var header = document.getElementById('header');
        var banner = document.getElementById('banner');
        
        // 创建一个新的 div 用于显示 Bing 壁纸，实现叠加淡入效果
        var newBanner = document.createElement('div');
        newBanner.style.position = 'absolute';
        newBanner.style.top = '0';
        newBanner.style.left = '0';
        newBanner.style.width = '100%';
        newBanner.style.height = '100%';
        newBanner.style.background = 'url(' + bingUrl + ') center #000';
        newBanner.style.backgroundAttachment = 'fixed';
        newBanner.style.backgroundSize = 'cover';
        newBanner.style.zIndex = '-1'; // 保持在底层
        newBanner.style.opacity = '0'; // 初始透明
        newBanner.style.transition = 'opacity 1s ease-in-out'; // 设置过渡动画
        
        // 将新 banner 插入到旧 banner 后面（DOM 顺序靠后即显示在上方）
        if (banner && banner.parentNode) {
           banner.parentNode.insertBefore(newBanner, banner.nextSibling);
        }
        
        // 触发重绘后改变透明度，启动淡入
        setTimeout(function() {
          newBanner.style.opacity = '1';
        }, 50);
      };
    })();
  </script>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <% if (is_post()) { %>
        <h1 id="logo-wrap">
          <span id="logo"><%= page.title %></span>
        </h1>
        <div id="subtitle-wrap" style="margin-top: 10px; color: #fff;">
          <span><i class="fa fa-calendar"></i> <%= date(page.date, 'YYYY-MM-DD') %></span>
          <% if (page.tags && page.tags.length){ %>
            <span style="margin-left: 15px;">
              <i class="fa fa-tags"></i>
              <%- list_tags(page.tags, {
                show_count: false,
                class: 'article-header-tag',
                style: 'none',
                separator: ' '
              }) %>
            </span>
          <% } %>
        </div>
      <% } else { %>
        <h1 id="logo-wrap">
          <a href="<%- url_for() %>" id="logo"><%= config.title %></a>
        </h1>
        <% if (theme.subtitle || config.subtitle){ %>
          <h2 id="subtitle-wrap">
            <a href="<%- url_for() %>" id="subtitle"><%= theme.subtitle || config.subtitle %></a>
          </h2>
        <% } %>
      <% } %>
    </div>
    <div id="header-inner" class="inner">
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>
        <% for (var i in theme.menu){ %>
          <a class="main-nav-link" href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
        <% } %>
      </nav>
      <nav id="sub-nav">
        <% if (theme.links) { %>
          <% for (const i in theme.links) {%>
            <a class="nav-icon" href="<%- url_for(theme.links[i]) %>"><span class="fa fa-<%= i %>"></span></a>
          <% } %>
        <% } %>
        <!-- RSS feed temporarily hidden 没想出这个部件的功能，就先暂时藏起来了 -->
        <!-- <% if (theme.rss){ %>
          <a class="nav-icon" href="<%- url_for(theme.rss) %>" title="<%= __('rss_feed') %>"><span class="fa fa-rss"></span></a>
        <% } %> -->
        <a class="nav-icon nav-search-btn" title="<%= __('search') %>"><span class="fa fa-search"></span></a>
      </nav>
      <div id="search-form-wrap">
        <form class="search-form" onsubmit="return false;">
            <input type="text" id="local-search-input" class="search-form-input" placeholder="Search...">
            <button type="submit" class="search-form-submit">&#xF002;</button>
        </form>
        <div id="local-search-result" class="local-search-result-cls"></div>
      </div>
    </div>
  </div>
  <% if (is_home()) { %>
  <div id="scroll-down">
    <span class="fa fa-chevron-down scroll-down-effects"></span>
  </div>
  <script>
    document.getElementById('scroll-down').addEventListener('click', function() {
      var headerHeight = document.getElementById('header').offsetHeight;
      window.scrollTo({
        top: headerHeight,
        behavior: 'smooth'
      });
    });
  </script>
  <% } %>
</header>
