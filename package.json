{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "obfuscate": "node tools/obfuscate.js",
    "obfuscate:index": "node tools/obfuscate.js index",
